+def isPrime(n):
+    halfN = int(n / 2)
+
+    for i in range(2, halfN):
+        if n % i == 0:
+            return False
+
+    return True
+
+
+
+def summationPrimes(n):
+    total = 0
+
+    for i in range((n-1),1,-1):
+        if isPrime(i):
+            total += i
+
+print(summationPrimes(2000000))
