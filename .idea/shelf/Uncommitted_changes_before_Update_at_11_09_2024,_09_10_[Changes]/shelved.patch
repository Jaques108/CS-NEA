+        #Make sure an operator exists - so when you spam click '=' it doesn't try to evaluate it again as its just the number
+        #If the user hasn't done something stupid, run the code
+        if currentNum != 'Error' and pos != -1:
+
+            #Split the two numbers up depending on where the operator is. For example, '340*29' will split up into firstNum = 340 and secondNum = 29
+            firstNum = float(currentNum[:pos])
+            secondNum = float(currentNum[pos + 1:])
+
+            #If you're stupid enough to try and divide by 0, there is no hope for you.
+            if secondNum == 0 and operation == '/':
+                currentNum = 'Error'
+
+            else:
+                #For some reason it still gives an error if you spam click '=', but not as severe as before so just stop the thingy from evaluating again
+                if operation == '=':
+                    pass
+
+                else:
+                    op_func = ops[operation]
+                    currentNum = str(round(op_func(firstNum, secondNum),4))
+
+
+    else:
+        #Join the operator so you can see what operation you're doing
+        currentNum += operation
+
+    outputLabel.config(text=currentNum)
+
+
+
+
+app.mainloop()
