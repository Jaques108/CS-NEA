+def rightShift():
+    biNumList = []
+
+    for i in range(8):
+        temp = biNumber[i]
+        if temp != '0' and temp != '1':
+            return 'Invalid - Number must only contain 0s and 1s'
+
+        biNumList.append(temp)
+
+    if operation == 'Logical' or operation == 'Arithmetic':
+        size = len(biNumList)
+        msb = str(biNumList[0])
+
+        if operation == 'Arithmetic' and msb == '0':
+            biNumList.insert(0,'0')
+
+        elif operation == 'Arithmetic' and msb == '1':
+            biNumList.insert(0,'1')
+
+        carryBit = biNumList[size]
+
+        biNumListTemp = biNumList[::-1]
+
+        biNumListTemp.remove(carryBit)
+        biNumList = biNumListTemp[::-1]
+
+        changedNum = ''
+
+        for i in range(size):
+            changedNum += biNumList[i]
+
+        return changedNum,carryBit
+
+
+    else:
+        return 'Error'
+
+
+def leftShift():
+    biNumList = []
+
+    for i in range(8):
+        temp = biNumber[i]
+        if temp != '0' and temp != '1':
+            return 'Invalid - Number must only contain 0s and 1s'
+
+        biNumList.append(temp)
+
+    if operation == 'Logical' or operation == 'Arithmetic':
+        size = len(biNumList)
+
+        biNumList.insert(7,'0')
+
+        carryBit = biNumList[0]
+        biNumList.remove(carryBit)
+
+
+        changedNum = ''
+
+        for i in range(size):
+            changedNum += biNumList[i]
+
+        return carryBit,changedNum
+
+
+    else:
+        return 'Error'
+
+if direction == 'Right':
+    print(rightShift())
+
+if direction == 'Left':
+    print(leftShift())
