+def Ascii(string1,string2):
+    length1 = len(string1)
+    length2 = len(string2)
+
+
+    if length1 == 0 or length2 == 0:
+        return 'Invalid Input'
+
+    else:
+        nums1 = []
+        nums2 = []
+        for i in range(length1):
+            temp = string1[i]
+            nums1.append(ord(temp))
+
+        for i in range(length2):
+            temp = string2[i]
+            nums2.append(ord(temp))
+
+
+        lengthNums1 = len(nums1)
+        lengthNums2 = len(nums2)
+
+        removedNumbers = []
+
+        for x in range(lengthNums1):
+            temp1 = nums1[x]
+            for j in range(lengthNums2):
+                temp2 = nums2[j]
+
+                if temp1 == temp2:
+                    removedNumbers.append(temp1)
+
+
+        for g in range(len(removedNumbers)):
+            temp = removedNumbers[g]
+            nums1.remove(temp)
+            nums2.remove(temp)
+
+
+        for n in range(len(nums1)):
+            temp = nums1[n]
+            nums1[n] = chr(temp)
+
+        for n in range(len(nums2)):
+            temp = nums2[n]
+            nums2[n] = chr(temp)
+
+
+        newString1 = ''.join(nums1)
+        newString2 = ''.join(nums2)
+
+        return newString1 + ' ' + newString2
+
+
+string1 = input('Enter first string : ')
+string2 = input('Enter second string : ')
+
+
+newString = Ascii(string1,string2)
+
+
+print(f"New string is '{newString}'")
+
+
+
