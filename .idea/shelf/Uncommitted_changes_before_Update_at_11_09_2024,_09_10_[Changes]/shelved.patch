+import re
+
+accepted = False
+
+
+def checkPassword(n):
+    password = str(n)
+    length = len(password)
+    specialChars = re.compile('[@_!#$%^&*"()<>?/|}{~:;§±£]')
+
+    if length < 8:
+        return 'Password is too short'
+
+    else:
+        cNum = False
+        cUp = False
+        cSpecial = False
+
+        if specialChars.search(password):
+            cSpecial = True
+
+        if not cSpecial:
+            return 'Password Needs a special character'
+
+        for i in range(length):
+            if cNum and cUp:
+                return 'Password accepted'
+
+            else:
+                char = password[i]
+                if char.isnumeric():
+                    cNum = True
+
+                elif char.isupper():
+                    cUp = True
+
+        return 'Password does not meet criteria'
+
+
+
+
+print('''
+Welcome to our register form
+''')
+
+username = input('Enter your username: ')
+
+
+
+print('''
+Password requirements are 
+1. Contains at least one number
+2. Contains at least one uppercase character
+3. Contains at least one special character
+4. Password needs to be at least 8 characters long
+''')
+
+
+
+while not accepted:
+    userPass = input('Enter your password: ')
+
+    check = checkPassword(userPass)
+    print(check)
+
+    if check == 'Password accepted':
+        accepted = True
+
+
+afile = open('Member details.txt','a')
+afile.write(f'\n\n Username : {username} \n Password : {userPass}')
+
+
