+import sys
+
+options = ['1','2','3','4','5']
+ages = ['Juveniles','Adults','Seniles']
+
+
+populationStats = []
+
+
+def setPop():
+    birthRateStr = 'x'
+
+    while birthRateStr.isalpha():
+        birthRateStr = input('What is the birth rate? ')
+
+    birthRate = float(birthRateStr)
+
+    while birthRate < 0:
+        birthRate = int(input('What is the birth rate? '))
+
+
+    populationStats.append([birthRate])
+
+
+    for i in range(3):
+        numbersStr = 'x'
+        survivalRateStr = 'x'
+
+
+        while numbersStr.isalpha() or survivalRateStr.isalpha():
+            numbersStr = input(f'Enter the number of {ages[i]} in the population ')
+            survivalRateStr = input(f'What is the survival rate for {ages[i]}? Enter a value from 0 to 1 ')
+
+
+        numbers = int(numbersStr)
+        survivalRate = float(survivalRateStr)
+
+
+        while numbers < 0 or (survivalRate < 0 or survivalRate > 1):
+            numbers = int(input(f'Enter the number of {ages[i]} in the population '))
+            survivalRate = float(input(f'What is the survival rate for {ages[i]}? Enter a value from 0 to 1 '))
+
+        survivalRateStr = str(survivalRate)
+
+        populationStats.append([numbers,ages[i],survivalRate,birthRate])
+
+    return populationStats
+
+
+
+def display():
+    if len(populationStats) == 0:
+        print('Model has not been created yet')
+
+    else:
+        print(populationStats)
+
+
+
+def run():#Shits about to get CRAZY
+
+    afile = open('Population Records.txt','a')
+
+    if len(populationStats) == 0:
+        print('Model has not been created yet')
+
+    else:
+        numGenerationsStr = 'x'
+
+        while numGenerationsStr.isalpha():
+            numGenerationsStr = input('How many generations do you want to model? The range is 5 - 25 : ')
+
+        numGenerations = int(numGenerationsStr)
+
+        while numGenerations < 5 or numGenerations > 25:
+            numGenerations = int(input('How many generations do you want to model? The range is 5 - 25 : '))
+
+
+        juveniles = populationStats[1][0]
+        adults = populationStats[2][0]
+        seniles = populationStats[3][0]
+
+        gen0 = f'Generation 0 : {juveniles} Juveniles, {adults} Adults, {seniles} Seniles.\n'
+        afile.write('\n-------------------------------------------------------------------------------------------------------\n' + gen0)
+        print(gen0)
+
+
+        juvenileSR = populationStats[0][0]
+        adultSR = populationStats[1][2]
+        senileSR = populationStats[3][2]
+
+
+
+        for x in range(numGenerations):
+            newNumJuveniles = int(round(adults * juvenileSR,0))
+            newNumAdults = int(round(juveniles * adultSR,0))
+            newNumSeniles = int(round((seniles * senileSR) + (adults * (populationStats[2][2])),0))
+
+            juveniles = newNumJuveniles
+            adults = newNumAdults
+            seniles = newNumSeniles
+
+
+            results = f'Generation {x + 1} : {juveniles} Juveniles, {adults} Adults, {seniles} Seniles.\n'
+            afile.write('\n' + results)
+            print(results)
+    afile.write('\n-------------------------------------------------------------------------------------------------------\n')
+    afile.close()
+
+
+
+
+print('''
+MAINMENU
+
+Welcome - Type the number of the option you would like to do
+
+1. Set the Generation 0 values
+2. Display the Generation 0 values
+3. Run the model
+4. Export data
+5. Quit.
+''')
+
+choice = -1
+
+while choice != '5':
+
+    choice = input('Enter Choice ')
+
+    if choice not in options:
+        print('Invalid input')
+
+
+    elif choice == '1':
+        setPop()
+
+
+    elif choice == '2':
+        display()
+
+    elif choice == '3':
+        run()
+
+    elif choice == '4':
+        print('Data Exported :)')
+
+
+    elif choice == '5':
+        check = input('Are you sure you want to Quit? Type "y" to confirm ').lower()
+
+        if check == 'y':
+            sys.exit()
+
+        else:
+            print('Okay, going back to Main Menu')
