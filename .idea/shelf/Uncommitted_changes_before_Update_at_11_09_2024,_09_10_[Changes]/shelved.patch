+def toBinary(num):
+    binaryNum = " "
+    completed = False
+    while not completed:
+        digit = str(num % 2)
+        binaryNum += digit
+        num //= 2
+
+        if num == 1:
+            completed = True
+
+    return binaryNum[::-1]
+
