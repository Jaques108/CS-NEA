+def properDivisors(n):
+    divs = []
+    halfN = (1 + int(n/2))
+
+    for i in range(1,halfN):
+        if n % i == 0:
+            divs.append(i)
+
+    return divs
+
+
+
+def sumPD(n):
+    divs = properDivisors(n)
+    total = 0
+
+    for x in range(len(divs)):
+        temp = divs[x]
+        total += temp
+
+    return total
+
+
+
+def checkIfAmicable(n):
+    PDNum1 = sumPD(n)
+    PDNum2 = sumPD(PDNum1)
+
+    if n == PDNum2 and PDNum1 != PDNum2:
+        return True
+
+    return False
+
+
+
+def sumOfAmicableNumbers(n):
+    total = 0
+
+    for j in range(1,n):
+        if checkIfAmicable(j):
+            total += j
+
+    return total
+
+
+
+print(sumOfAmicableNumbers(10000))
+
